        "reference_context.native.source_dataset",
        "reference_context.native.sequence_id",
        "reference_context.native.component",
        "reference_context.native.source_parent_status",
        "reference_context.native.reference_identity_count",
        "reference_context.native.reference_full_sequence_count",
        "reference_context.native.reference_occurrence_count",
        "reference_context.native.table_number",
